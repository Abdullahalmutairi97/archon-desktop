# Template only. Do not store live credentials in backend/.env or commit them.
# Provision the bearer token into a mode-0600 external service file (with the
# privileges needed for its parent directory), or use deploy/install-server.sh:
#   sudo deploy/install-server.sh --workspace-root /absolute/workspace/root \
#     --confirm-workspace-roots-complete
# Add every configured scratch and registered project root to that command.
# ARCHON_DESKTOP_AUTH_TOKEN=<generated-token>

# The backend listener accepts loopback addresses only. Remote clients require an
# operator-managed private authenticated HTTPS proxy in front of this listener.
ARCHON_DESKTOP_BIND_HOST=127.0.0.1
ARCHON_DESKTOP_REMOTE_ACCESS_MODE=disabled
# ARCHON_DESKTOP_REMOTE_ACCESS_MODE=private_tls_proxy
# ARCHON_DESKTOP_REMOTE_BASE_URL=https://private-proxy.example.test
# ARCHON_DESKTOP_FIXTURE_MODE=false

# Telegram bot bridge. Keep secrets in the same protected external service file.
# ARCHON_DESKTOP_TELEGRAM_BOT_TOKEN=<telegram-token>
# ARCHON_DESKTOP_TELEGRAM_ALLOWED_USER_ID=<numeric-user-id>

# Compatibility setting only. Started tasks never retry automatically.
ARCHON_DESKTOP_QUOTA_RETRY_SECONDS=18000

# Optional: register a narrower task scratch directory than ARCHON_DESKTOP_ARCHON_ROOT.
# ARCHON_DESKTOP_TASK_SCRATCH_ROOT=/absolute/existing/scratch
# Explicit aliases only; Hermes roster names are not automatically executable.
# ARCHON_DESKTOP_RUNTIME_PROFILE_ALIASES={"my-prime-profile":"prime"}
# ARCHON_DESKTOP_PI_EXECUTABLE=/absolute/path/to/pi
