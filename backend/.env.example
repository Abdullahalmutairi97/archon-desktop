# Secrets only. Generate with: openssl rand -hex 32
ARCHON_DESKTOP_AUTH_TOKEN=

# Telegram bot bridge. Both fields are required to enable it.
ARCHON_DESKTOP_TELEGRAM_BOT_TOKEN=
ARCHON_DESKTOP_TELEGRAM_ALLOWED_USER_ID=

# Compatibility setting only. Started tasks never retry automatically.
ARCHON_DESKTOP_QUOTA_RETRY_SECONDS=18000

# Optional: register a narrower task scratch directory than ARCHON_DESKTOP_ARCHON_ROOT.
# ARCHON_DESKTOP_TASK_SCRATCH_ROOT=/absolute/existing/scratch
# Explicit aliases only; Hermes roster names are not automatically executable.
# ARCHON_DESKTOP_RUNTIME_PROFILE_ALIASES={"my-prime-profile":"prime"}
# ARCHON_DESKTOP_PI_EXECUTABLE=/absolute/path/to/pi
