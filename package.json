{
  "name": "archon-desktop-repository",
  "version": "0.3.0",
  "private": true,
  "description": "Archon Desktop — v0.3.0 release kit and shared backend",
  "scripts": {
    "setup": "npm --prefix current ci",
    "test": "npm --prefix current test",
    "build": "npm --prefix current run build --",
    "build:candidate": "npm --prefix current run build:candidate --",
    "test:backend": "python3 scripts/test-backend.py",
    "desktop:setup": "npm ci --prefix desktop",
    "desktop:dev": "npm run dev --prefix desktop",
    "desktop:typecheck": "npm run typecheck --prefix desktop",
    "desktop:test": "npm run test --prefix desktop",
    "desktop:build": "npm run build --prefix desktop",
    "desktop:preview": "npm run build --prefix desktop && npm run preview --prefix desktop"
  }
}
