[Unit]
Description=Archon Desktop private backend
Documentation=file://@PROJECT_ROOT@/README.md
Wants=network-online.target tailscale-online.target
After=network-online.target tailscale-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@/backend
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@PROJECT_ROOT@/backend/.env
ExecStart=@PROJECT_ROOT@/backend/.venv/bin/python -m archon_server.main
Restart=always
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
