[Unit]
Description=Archon Desktop private backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@WORKING_DIRECTORY@
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@ENV_FILE@
ExecStart=@PYTHON@ -m archon_server.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
