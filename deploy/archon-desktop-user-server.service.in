[Unit]
# Managed by deploy/install-user-server.sh.
Description=Archon Desktop local backend
After=default.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=@ENV_FILE@
ExecStart=@PYTHON@ -m archon_server.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
